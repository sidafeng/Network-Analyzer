<Window x:Class="Network_Analyzer.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About"
        Width="360"
        Height="230"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <StackPanel Margin="7">
        <TextBlock Text="Network Analyzer"
                   FontSize="22"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"/>

        <TextBlock Text="Version 0.01"
                   Margin="0,8,0,0"
                   HorizontalAlignment="Center"/>

        <TextBlock TextWrapping="Wrap"
                   TextAlignment="Center"
                   Margin="0,15,0,0">
                   A network packet capture and analysis tool. 
                    <LineBreak/>
                   (A poor man's Wireshark) 
                    <LineBreak/>
                   Built with Sharpcap, "
                    <LineBreak/>
                   Author: SF
        </TextBlock>
        <Button Content="Close"
                Width="90"
                Height="30"
                HorizontalAlignment="Center"
                Margin="0,18,0,0"
                Click="Close_Click"/>
    </StackPanel>
</Window>