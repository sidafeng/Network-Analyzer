<Window x:Class="Network_Analyzer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Network_Analyzer"
        mc:Ignorable="d"
        Title="MainWindow" Height="850" Width="1600">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="File">
                <MenuItem Header="Open" Click="MenuItem_FileOpen_Click"/>
                <MenuItem Header="Save" Click="MenuItem_FileSave_Click"/>
                <MenuItem Header="Save As" Click="MenuItem_FileSaveAs_Click"/>
                <MenuItem Header="Exit"/>
            </MenuItem>
            <MenuItem Header="View">
                <MenuItem Header="View All"/>
            </MenuItem>
            <MenuItem Header="Help">
                <MenuItem Header="About"/>
            </MenuItem>
        </Menu>


        <Grid Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="2*" />
                <RowDefinition Height="5" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ***1.Button/Filter bar*** -->
            <StackPanel Grid.Row="0"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Margin="0,0,50,5">
                <TextBlock Text="Packet Filter:"
                   VerticalAlignment="Center"
                   Margin="0,0,5,0" />
                <TextBox x:Name="FilterTextBox"
                 Width="350"
                 Height="28"
                 VerticalContentAlignment="Center"/>


                <Button Content="Clear"
                Width="70"
                Height="28"
                Margin="5,0,0,0" />
            </StackPanel>

            <StackPanel Grid.Row="0"
            Orientation="Horizontal"
            HorizontalAlignment="Left"
            Margin="0,0,0,5">

                <ToggleButton x:Name="btnCapture"
                  Content="CAPTURE"
                  Width="110"
                  Height="28"
                  VerticalAlignment="Center"
                  FontFamily="Source Sans Pro Black"
                  FontSize="16"
                  Foreground="#FF08FF20"
                  Checked="btnCapture_Clicked"
                  Unchecked="btnCapture_Unclicked">

                    <ToggleButton.Background>
                        <LinearGradientBrush EndPoint="0.5,1"
                                 StartPoint="0.5,0">
                            <GradientStop Color="#FFC3C3C3" Offset="0" />
                            <GradientStop Color="#FFFAF0F0" Offset="1" />
                        </LinearGradientBrush>
                    </ToggleButton.Background>
                </ToggleButton>

                <TextBlock Text="Capture device:"
               VerticalAlignment="Center"
               Margin="12,0,5,0" />

                <ComboBox x:Name="CaptureDeviceComboBox"
              Width="350"
              Height="28"
              VerticalContentAlignment="Center" />
            </StackPanel>


            <!-- ***MainDisplayArea***-->
            <DataGrid x:Name="PacketGrid"
              Grid.Row="1"
              SelectionChanged="PacketGrid_Select"
              AutoGenerateColumns="False"
              IsReadOnly="True"
              CanUserAddRows="False">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="No." Width="60"
                        Binding="{Binding Number}" />
                    <DataGridTextColumn Header="Time" Width="150"
                        Binding="{Binding Timestamp, StringFormat=HH:mm:ss.fff}" />
                    <DataGridTextColumn Header="Source" Width="*"
                        Binding="{Binding Source}" />
                    <DataGridTextColumn Header="Source Port" Width="90"
                        Binding="{Binding SourcePort}" />
                    <DataGridTextColumn Header="Destination" Width="*"
                        Binding="{Binding Destination}" />
                    <DataGridTextColumn Header="Destination Port"  Width="110"
                        Binding="{Binding DestinationPort}" />
                    <DataGridTextColumn Header="Protocol" Width="100"
                        Binding="{Binding Protocol}" />
                    <DataGridTextColumn Header="Length" Width="80"
                        Binding="{Binding Length}" />
                    <DataGridTextColumn Header="Info" Width="2*"
                        Binding="{Binding Info}" />
                </DataGrid.Columns>
            </DataGrid>

            <!-- ***Resize bar*** -->
            <GridSplitter Grid.Row="2"
                  Height="5"
                  HorizontalAlignment="Stretch" />

            <!-- ***Bottom area*** -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="5" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- ***3.Packet details*** -->
                <TreeView x:Name="PacketDetailsTree"
                  Grid.Column="0">
                    <TreeViewItem Header="Select a packet to view its details" />
                </TreeView>

                <!-- ***Resize bar*** -->
                <GridSplitter Grid.Column="1" Width="5" VerticalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" />

                <!-- ***4.Raw packet bytes*** -->
                <TextBox x:Name="HexViewer"
                 Grid.Column="2"
                 IsReadOnly="True"
                 FontFamily="Consolas"
                 Text="Raw packet bytes will appear here."
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto" />
            </Grid>
            <ToggleButton x:Name="btnDarkMode"
              Width="24"
              Height="24"
              FontSize="12"
              Foreground="White"
              HorizontalAlignment="Right"
              VerticalAlignment="Top"
              Margin="0,2,12,0"
              Checked="DarkMode_Checked"
              Unchecked="DarkMode_Unchecked">

                <ToggleButton.Template>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border x:Name="Circle"
                    Background="#777777"
                    BorderBrush="#444444"
                    BorderThickness="1"
                    CornerRadius="20">
                            <ContentPresenter HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Circle"
                            Property="Background"
                            Value="LimeGreen" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </ToggleButton.Template>
            </ToggleButton>
        </Grid>
    </DockPanel>
</Window>
