<Window x:Class="Network_Analyzer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MainWindow" Height="850" Width="1600"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <DockPanel>
        <Menu x:Name ="MainMenu" 
             Background="{DynamicResource SidebarBrush}"
             Foreground="{DynamicResource TextPrimaryBrush}"
             DockPanel.Dock="Top">
            <MenuItem x:Name = "DropDownMenu" Header="File">
                <MenuItem Header="Open" Foreground="#1A2535" Click="MenuItem_FileOpen_Click"/>
                <MenuItem Header="Save" Foreground="#1A2535" Click="MenuItem_FileSave_Click"/>
                <MenuItem Header="Save As" Foreground="#1A2535" Click="MenuItem_FileSaveAs_Click"/>
                <MenuItem Header="Exit" Foreground="#1A2535" Click="MenuItem_Exit_Click"/>
            </MenuItem>
            <MenuItem Header="View">
                <MenuItem Header="Clear Grid" Foreground="#1A2535" Click="Clear_Grid_Click"/>
                <MenuItem Header="View TimeLine" Foreground="#1A2535" Click="ViewTimeLine_Click"/>
            </MenuItem>
            <MenuItem Header="Help">
                <MenuItem Header="About" Foreground="#1A2535" Click="MenuItem_About_Click"/>
            </MenuItem>
  
        </Menu>


        <Grid Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="2*" />
                <RowDefinition Height="5" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ***1.Button/Filter bar*** -->
            <StackPanel Grid.Row="0"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Margin="0,0,50,5">
                <TextBlock Text="Packet Filter:"
                   VerticalAlignment="Center"
                   Margin="0,0,5,0" />
                <TextBox x:Name="FilterTextBox"
                 Width="350"
                 Height="28"
                 VerticalContentAlignment="Center"
                 TextChanged="FilterTextBox_TextChanged"/>
                <Popup x:Name="SuggestionPopup"
                   PlacementTarget="{Binding ElementName=FilterTextBox}"
                   Placement="Bottom"
                   StaysOpen="False">
                    <ListBox x:Name="SuggestionList"
                     Background="{DynamicResource SurfaceBrush}"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     Width="200"
                     MaxHeight="150"
                     MouseDoubleClick="SuggestionList_MouseDoubleClick"/>
                </Popup>

                <Button Content="Clear"
                Width="70"
                Height="28"
                Margin="5,0,0,0" 
                VerticalContentAlignment="Center"
                HorizontalContentAlignment="Center"
                Padding="0"
                Click="ClearFilter_Click"/>
            </StackPanel>

            <StackPanel Grid.Row="0"
            Orientation="Horizontal"
            HorizontalAlignment="Left"
            Margin="0,0,0,5">

                <ToggleButton x:Name="btnCapture"
                  Content="CAPTURE"
                  Width="110"
                  Height="28"
                  VerticalAlignment="Center"
                  FontFamily="Source Sans Pro Black"
                  FontSize="16"
    
                  Checked="btnCapture_Clicked"
                  Unchecked="btnCapture_Unclicked"

                  Background="{DynamicResource SurfaceBrush}"
                  Foreground="{DynamicResource SuccessBrush}">
                </ToggleButton>

                <TextBlock Text="Capture device:"
               VerticalAlignment="Center"
               Margin="12,0,5,0" />

                <ComboBox x:Name="CaptureDeviceComboBox"
                 Background="{DynamicResource SurfaceBrush}"
                 Foreground="Black"
                 BorderBrush="{DynamicResource BorderBrush}"
                 Width="350"
                 Height="28"
                 VerticalContentAlignment="Center" />
            </StackPanel>


            <!-- ***MainDisplayArea***-->
            <DataGrid x:Name="PacketGrid"
              Grid.Row="1"
              RowHeight="25"
              SelectionChanged="PacketGrid_Select"
              AutoGenerateColumns="False"
              IsReadOnly="True"
              HeadersVisibility="Column"
              Background="{DynamicResource SurfaceBrush}"
              Foreground="{DynamicResource TextPrimaryBrush}"
              CanUserAddRows="False">


                <DataGrid.Columns>
                    <DataGridTextColumn Header="No." Width="60"
                        Binding="{Binding Number}" />
                    <DataGridTextColumn Header="Time" Width="150"
                        Binding="{Binding Timestamp, StringFormat=HH:mm:ss}" />
                    <DataGridTextColumn Header="Source" Width="*"
                        Binding="{Binding Source}" />
                    <DataGridTextColumn Header="Source Port" Width="90"
                        Binding="{Binding SourcePort}" />
                    <DataGridTextColumn Header="Destination" Width="*"
                        Binding="{Binding Destination}" />
                    <DataGridTextColumn Header="Destination Port"  Width="110"
                        Binding="{Binding DestinationPort}" />
                    <DataGridTextColumn Header="Protocol" Width="100"
                        Binding="{Binding Protocol}" />
                    <DataGridTextColumn Header="Length" Width="80"
                        Binding="{Binding Length}" />
                    <DataGridTextColumn Header="Info" Width="2*"
                        Binding="{Binding Info}" />
                </DataGrid.Columns>
            </DataGrid>

            <!-- ***Resize bar*** -->
            <GridSplitter Grid.Row="2"
                  Height="5"
                  HorizontalAlignment="Stretch" />

            <!-- ***Bottom area*** -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="5" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- ***3.Packet details*** -->
                <TreeView x:Name="PacketDetailsTree"
                  Background="{DynamicResource SurfaceBrush}"
                  Foreground="{DynamicResource TextPrimaryBrush}"
                  Grid.Column="0">
                    <TreeView.Resources>
                        <Style TargetType="{x:Type TreeViewItem}">
                            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TreeView}}"/>
                        </Style>
                    </TreeView.Resources>
                    <TreeViewItem Header="Select a packet to view its details" />
                </TreeView>

                <!-- ***Resize bar*** -->
                <GridSplitter Grid.Column="1" Width="5" VerticalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" />

                <!-- ***CLI rules Alert s*** -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Current rules -->
                    <ListBox x:Name="RuleList"
                         Grid.Row="0"
                         FontFamily="Consolas"
                         FontSize="13"
                         Background="{DynamicResource SurfaceBrush}"
                         Foreground="{DynamicResource TextPrimaryBrush}"/>

                    <!-- CLI rule input -->
                    <Border Grid.Row="1"
                        Height="30"
                        Margin="0,5,0,0"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1">

                        <DockPanel>
                            <TextBlock Text=">>"
                               DockPanel.Dock="Left"
                               FontFamily="Consolas"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center"
                               Margin="8,0,6,0"/>

                            <TextBox x:Name="RuleInput"
                                 FontFamily="Consolas"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 VerticalContentAlignment="Center"
                                 KeyDown="EnterKey"/>
                        </DockPanel>
                    </Border>
                </Grid>


            </Grid>
            <ToggleButton x:Name="btnDarkMode"
              Width="24"
              Height="24"
              FontSize="12"
              Foreground="White"
              HorizontalAlignment="Right"
              VerticalAlignment="Top"
              Margin="0,2,12,0"
              Checked="DarkMode_Checked"
              Unchecked="DarkMode_Unchecked">

                <ToggleButton.Template>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border x:Name="Circle"
                         Background="{DynamicResource TextPrimaryBrush}"
                         BorderBrush="{DynamicResource BorderBrush}"
                         BorderThickness="1"
                         CornerRadius="20">
                            <ContentPresenter HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Circle"
                                        Property="Background"
                                        Value="{DynamicResource AccentHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </ToggleButton.Template>
            </ToggleButton>
        </Grid>
    </DockPanel>
</Window>
